# Copie para .env.local e ajuste. NUNCA coloque segredos em variáveis VITE_*:
# tudo que começa com VITE_ é embutido no JavaScript público do site.

# Backend dos repositórios.
#   demo = tudo no navegador (padrão em desenvolvimento e testes)
#   php  = cardápio no servidor (pasta api/) + editor por link secreto.
#          Já está definido em .env.production, usado por "npm run build".
VITE_BACKEND=demo

# Liga o painel /admin de demonstração (dados só no navegador) mesmo com VITE_BACKEND=php.
# VITE_ENABLE_DEMO_ADMIN=true

# Futuro backend real (ex.: Supabase, Firebase ou API própria).
# Só valores PÚBLICOS (URL e chave anônima). Chaves de serviço ficam no servidor, nunca aqui.
# VITE_API_URL=
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# URL pública do site em produção, sem barra final (ex.: https://tremdedoido.com.br).
# Usada em canonical e og:image no build. Em produção vem de .env.production
# (https://tremdedoidobbq.com.br). Vazio = caminhos relativos.
VITE_SITE_URL=
